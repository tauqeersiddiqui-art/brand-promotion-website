# REQUIRED: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Brand Promotion

# OCR (review screenshots) - free key from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=

# Google login (optional) - https://console.cloud.google.com/apis/credentials
# Redirect URI to register: http://localhost:3000/api/auth/google/callback
# (plus your production URL, e.g. https://yourdomain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: this email auto-becomes the owner when signing up (before any admin exists)
ADMIN_EMAIL=

# Optional: used by scripts/seed.js to create/reset the owner password on first seed
ADMIN_PASSWORD=

# Optional: Telegram channel auto-posting
# 1. Chat with @BotFather -> /newbot -> copy the token here
# 2. Add the bot to your channel as an admin (allow "Post messages")
# New campaigns auto-post on creation; existing ones via the "Post TG" button
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@brandreviewer

# Optional: Google AdSense ads (leave blank to keep ads disabled)
# Client ID looks like ca-pub-1234567890123456, slots are created per ad unit in AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_STORES=
NEXT_PUBLIC_ADSENSE_SLOT_DEAL=
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=

# Automatic backups (orders, users, deals, reviews, claims + uploaded screenshots).
# Every server start writes a backup and restores the newest one when the
# database is freshly seeded/wiped. On Render's free tier the local disk is
# erased on each deploy, so point BACKUP_DIR at a persistent disk (e.g.
# /var/data/backups mounted from a Render disk) to survive deploys.
BACKUP_DIR=
AUTO_BACKUP_MINUTES=5
AUTO_RESTORE=1
