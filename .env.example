[TEMPLATE]
# REQUIRED: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# Railway: you can leave this empty — Railway provides RAILWAY_PUBLIC_DOMAIN
# automatically (e.g. brand-promotion-website-production.up.railway.app).
# If you set it, use your new Railway URL (no trailing slash):
# NEXT_PUBLIC_BASE_URL=https://brand-promotion-website-production.up.railway.app
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_NAME=Brand Promotion

# OCR (review screenshots) - free key from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=

# Google login (optional) - https://console.cloud.google.com/apis/credentials
# Redirect URI to register: http://localhost:3000/api/auth/google/callback
# (plus your Railway production URL: https://brand-promotion-website-production.up.railway.app/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: this email auto-becomes the owner when signing up (before any admin exists)
ADMIN_EMAIL=

# Optional: used by scripts/seed.js ONCE to create the owner account.
# It does NOT reset an existing account's password on boot (that reverted UI
# password changes and leaked the password into deploy logs). To force a reset,
# run: node scripts/seed.js --sync-password
ADMIN_PASSWORD=

# Optional: Admin notifications (Email + WhatsApp) on order / refund / claim
# Email via Resend — https://resend.com (API Keys -> create sending key)
RESEND_API_KEY=
# From address must be on a verified domain (or onboarding@resend.dev for testing)
NOTIFY_FROM_EMAIL=alerts@brandpromotion.in
# Where alerts go (defaults to support_email setting)
NOTIFY_TO_EMAIL=
# WhatsApp via Meta WhatsApp Business Cloud API — https://developers.facebook.com (WhatsApp -> Cloud API)
# Create a template message first, e.g. `new_order_alert` with {{1}} in header + body
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=new_order_alert
# Your WhatsApp number with country code (defaults to the whatsapp setting)
ADMIN_WHATSAPP_NUMBER=

# Optional: Telegram channel auto-posting
# 1. Chat with @BotFather -> /newbot -> copy the token here
# 2. Add the bot to your channel as an admin (allow "Post messages")
# New campaigns auto-post on creation; existing ones via the "Post TG" button
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@brandreviewer

# Optional: Google AdSense ads (leave blank to keep ads disabled)
# Client ID looks like ca-pub-1234567890123456, slots are created per ad unit in AdSense
# Already hardcoded fallback is ca-pub-7773361971010362 — see src/lib/adsense.ts
# After moving Render -> Railway, add this URL in AdSense: https://brand-promotion-website-production.up.railway.app
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_STORES=
NEXT_PUBLIC_ADSENSE_SLOT_DEAL=
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=

# Persistent storage on Railway: the volume is mounted at /data (see railway.toml).
# Set DATA_DIR=/data so the SQLite database and uploads survive deploys.
DATA_DIR=/data
DATABASE_PATH=
UPLOAD_DIR=

# Automatic backups (orders, users, deals, reviews, claims + uploaded screenshots).
# Every server start writes a backup. AUTO_RESTORE (below) is OFF unless set to 1;
# when enabled it restores the newest backup over a freshly seeded database.
# On Railway, without a volume, local disk is wiped on deploy — BACKUP_DIR is
# inside the Railway volume at /data/backups (see railway.toml [[volume]] mount=/data).
BACKUP_DIR=/data/backups
# Click tracking stores IP/user-agent per click; rows older than this are pruned
# on boot (default 180 days).
CLICK_RETENTION_DAYS=180
AUTO_BACKUP_MINUTES=5
# Set to 1 to enable auto-restore (off by default since it can resurrect data).
AUTO_RESTORE=
